# OpenAI-compatible LLM configuration for ai-code-review-agent.
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# LLM_BASE_URL: The chat-completions endpoint of any OpenAI-compatible provider.
#   Examples:
#     - OmniRoute: http://localhost:20128/v1
#     - OpenAI:    https://api.openai.com/v1
#     - Local:     http://127.0.0.1:1234/v1
LLM_BASE_URL=http://localhost:20128/v1

# LLM_API_KEY: Bearer token for the LLM endpoint. Required for real calls.
# Do NOT use real credential values here — this is a placeholder template.
LLM_API_KEY=your-api-key-here

# LLM_MODEL: The model name to send to the provider (e.g. "openai/gpt-4o-mini",
# "deepseek/deepseek-chat", "anthropic/claude-3-5-sonnet-20241022").
LLM_MODEL=openai/gpt-4o-mini
